
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Role Assign";
    Layout = "_Layout";
}

<form class="form-control" asp-action="Assign" asp-controller="Role" method="post">
    <label for="UserId">UserId</label>
    <input class="form-control" name="UserId" for="UserId" type="text" placeholder="UserId" />
    <label for="RoleId">RoleId</label>
    <input class="form-control" name="RoleId" for="RoleId" type="text" placeholder="RoleId" />
    <button class="btn btn-success" type="submit">Create</button>
</form>
